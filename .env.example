# Copy to .env and fill in. Never commit .env.

# --- Site ---
# Read at runtime by the server (deliberately not NEXT_PUBLIC_*: those are frozen into the build).
SERVER_URL=http://localhost:3000
# Search engines are kept out until launch (placeholder content must not be indexed).
ALLOW_INDEXING=false
NEXT_TELEMETRY_DISABLED=1

# --- Payload CMS ---
# At least 32 random bytes, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=

# --- Control Center (docs/CONTROL-CENTER.md) ---
# Its own host in production, e.g. https://verwaltung.yop-ye.org: the admin and the API answer
# only there, and the public host returns 404 for /admin and /api (media files excepted).
# Empty in development: everything runs on SERVER_URL.
ADMIN_URL=
# Encrypts the authenticator secrets of the two-factor sign-in (32+ random bytes, e.g.
# `openssl rand -hex 32`). If empty, a key is derived from PAYLOAD_SECRET. Changing it later
# means every account sets up its authenticator app again.
MFA_ENCRYPTION_KEY=
# Optional: the reverse proxy sends this value as "x-admin-gate" on the admin host only (see
# the deployment guide); requests to the admin host without it then get 404. Leave empty until
# the proxy is configured, otherwise the admin is unreachable.
ADMIN_GATE_SECRET=

# --- PostgreSQL ---
POSTGRES_USER=yop
POSTGRES_PASSWORD=
POSTGRES_DB=yop
# For `npm run dev` on the host; inside Docker compose this is set automatically.
DATABASE_URL=postgres://yop:CHANGE_ME@localhost:5432/yop

# --- S3-compatible media storage (production: an EU-region provider) ---
# Local development uses SeaweedFS from docker-compose.yml.
S3_ENDPOINT=http://localhost:8333
S3_REGION=eu-central-1
S3_BUCKET=yop-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- E-mail (optional) ---
# Without SMTP_HOST nothing is sent (and nothing is written to the log instead).
# Used for: notifications about new applications/messages (no personal data in them) and
# password-reset e-mails for CMS accounts. Port 465 = TLS, other ports require STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Receives "new application / new message" notifications (plan §18, Q7).
NOTIFY_EMAIL=info@yop-ye.org
# A mail server entered in the Control Center is used only on ports 25, 465, 587 or 2525 and
# only if its name resolves to internet addresses (not this machine, not a private network).
# "true" allows a relay inside the server's network there too. SMTP_HOST above is always used.
MAIL_ALLOW_INTERNAL_HOSTS=

# --- Association decisions (server settings, deliberately not in the interface) ---
# Months the audit log and the export register are kept; empty = 12 (decided 2026-10-20).
AUDIT_RETENTION_MONTHS=
# "on" moves the personal data of accepted applications into the member register (proposal
# for decision 12, docs/CONTROL-CENTER.md §16). Stays "off" until the association decides.
MEMBERSHIP_CONSOLIDATION=off

# --- Production server (docker-compose.prod.yml, docs/OPERATIONS.md) ---
# Host names without https://. Caddy requests the certificates for both (Let's Encrypt).
SITE_HOST=
ADMIN_HOST=
# Contact address for the certificate authority (expiry warnings).
ACME_EMAIL=
# Optional: networks allowed to open the Control Center, space-separated (e.g. the office's
# address "203.0.113.0/24"). Empty = everyone; the sign-in with two factors applies either way.
ADMIN_ALLOW_IPS=
# Release shown in the Control Center (set by the deployment, e.g. the git tag and commit).
APP_VERSION=
APP_COMMIT=

# --- Operations agent (docs/CONTROL-CENTER.md §17) ---
# Shared by the app and the agent to sign every request (32+ random characters, e.g.
# `openssl rand -hex 32`). Without it the agent does not start and the Control Center shows
# "not set up".
OPS_AGENT_SECRET=
# Development only: the agent's address when it runs outside Docker compose.
OPS_AGENT_URL=

# --- Backups (decision 9) ---
# restic repository on an EU storage provider with object lock, e.g.
# s3:https://s3.example-provider.eu/yop-backups — empty = backups not set up.
RESTIC_REPOSITORY=
# Encrypts the backups. Keep a copy offline with the board: without it no backup can be read.
RESTIC_PASSWORD=
# Credentials for the backup storage (a key that can write, not delete, where the provider
# supports it).
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Local time (Europe/Berlin): nightly backup and the weekly restore drill.
BACKUP_TIME=02:30
DRILL_DAY=sun
DRILL_TIME=04:00
# Snapshots kept after each backup (proposal until decision 9; empty = these values).
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# --- Logging ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
