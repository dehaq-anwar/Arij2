{
  "name": "yop-website",
  "version": "0.1.0",
  "private": true,
  "description": "Website of Youth of Peace e.V. (Erlangen) — Next.js + Payload CMS, de/en/ar",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && node scripts/check-logical-css.mjs && node scripts/check-motion-direction.mjs && node scripts/check-contrast.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:deps": "node scripts/check-release-age.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:deps && npm run check:audit",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "check:audit": "node scripts/check-audit.mjs",
    "test:e2e": "playwright test",
    "check:placeholders": "node scripts/check-placeholders.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "graphql": "16.14.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "undici": "7.29.1",
    "dompurify": "3.4.16"
  }
}
